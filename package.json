{
  "name": "poi-plugin-hensei-nikki",
  "version": "5.0.5",
  "description": "a plugin which can save your fleet organize for poi",
  "main": "index.js",
  "dependencies": {},
  "devDependencies": {
    "poi-util-transpile": "^8.2.2",
    "sass": "^1.92.1",
    "typescript": "6.0.3"
  },
  "scripts": {
    "build:css": "sass --no-source-map assets/hensei-nikki.scss assets/hensei-nikki.css",
    "watch:css": "sass --watch --no-source-map assets/hensei-nikki.scss assets/hensei-nikki.css",
    "build:core": "node ./node_modules/typescript/bin/tsc --outDir .quality/core --noEmit false && cp .quality/core/utils/fleet-data.js utils/fleet-data.js",
    "build:js": "npm run build:core && poi-util-transpile",
    "build": "npm run build:css && npm run build:js",
    "prepack": "npm run build",
    "postpublish": "npm run reset",
    "reset": "git checkout . && git clean -f",
    "test": "rm -rf .quality && node ./node_modules/typescript/bin/tsc --outDir .quality --noEmit false && node --test test/fleet-data.test.js",
    "typecheck": "node ./node_modules/typescript/bin/tsc --noEmit",
    "check:no-any": "sh scripts/check-no-explicit-any.sh",
    "check:package": "node scripts/check-package.mjs",
    "check": "npm run test && npm run typecheck && npm run build && npm run check:package && npm run check:no-any"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/poooi/plugin-hensei-nikki/"
  },
  "keywords": [
    "poi",
    "henseinikki",
    "kancolle",
    "hensei",
    "nikki"
  ],
  "author": {
    "name": "Rui",
    "link": "https://github.com/ruiii"
  },
  "license": "MIT",
  "poiPlugin": {
    "title": "Display Name",
    "description": "Description",
    "icon": "fa/folder-open",
    "priority": 7,
    "apiVer": {
      "6.99.99": "3.9.4"
    }
  }
}
