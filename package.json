{
  "name": "poi-plugin-hensei-nikki",
  "version": "5.0.5",
  "description": "a plugin which can save your fleet organize for poi",
  "main": "index.js",
  "dependencies": {},
  "devDependencies": {
    "sass": "^1.92.1",
    "typescript": "^6.0.3"
  },
  "scripts": {
    "build:css": "sass --no-source-map assets/hensei-nikki.scss assets/hensei-nikki.css",
    "watch:css": "sass --watch --no-source-map assets/hensei-nikki.scss assets/hensei-nikki.css",
    "build:ts": "tsc --project tsconfig.json",
    "build": "npm run build:ts && npm run build:css",
    "typecheck": "tsc --project tsconfig.json --noEmit",
    "no-explicit-any": "node scripts/check-quality.js",
    "package:check": "node scripts/check-package.js",
    "check": "npm run typecheck && npm run no-explicit-any && npm test && npm run build && npm run package:check",
    "prepack": "npm run build",
    "postpublish": "npm run reset",
    "reset": "git checkout . && git clean -f",
    "test": "npm run build:ts && node --test test/*.test.js"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/poooi/plugin-hensei-nikki/"
  },
  "keywords": [
    "poi",
    "henseinikki",
    "kancolle",
    "hensei",
    "nikki"
  ],
  "author": {
    "name": "Rui",
    "link": "https://github.com/ruiii"
  },
  "license": "MIT",
  "poiPlugin": {
    "title": "Display Name",
    "description": "Description",
    "icon": "fa/folder-open",
    "priority": 7,
    "apiVer": {
      "6.99.99": "3.9.4"
    }
  }
}
