{
  "compilerOptions": {
    "target": "ES2018",
    "module": "CommonJS",
    "strict": true,
    "noEmit": false,
    "declaration": false,
    "jsx": "react",
    "sourceMap": true,
    "outDir": ".",
    "rootDir": ".",
    "skipLibCheck": false
  },
  "include": ["index.tsx", "redux/**/*.ts", "utils/**/*.ts", "components/**/*.tsx", "containers/**/*.tsx", "types/**/*.d.ts"],
  "exclude": ["node_modules"]
}
